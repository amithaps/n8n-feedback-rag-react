    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "output_items = []\n\nfor incoming_object in _items:\n    full_policy_text = incoming_object.get(\"json\", {}).get(\"text\", \"\")\n    \n    # FIX: Standardize Windows carriage returns (\\r\\n) into simple Linux newlines (\\n)\n    clean_text = full_policy_text.replace(\"\\r\\n\", \"\\n\")\n    \n    # Split text on double line breaks (paragraphs)\n    policy_sections = clean_text.split(\"\\n\\n\")\n    \n    for index, section in enumerate(policy_sections):\n        section_text = section.strip()\n        \n        # Skip completely empty text chunks\n        if not section_text:\n            continue\n            \n        # Append explicitly using the strict n8n list-of-dicts schema\n        output_items.append({\n            \"json\": {\n                \"chunk_id\": index + 1,\n                \"chunk_text\": section_text\n            }\n        })\n\nreturn output_items\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
