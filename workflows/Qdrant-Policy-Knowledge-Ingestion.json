      "id": "6eb01da5-1c5e-439c-af6e-37853298c4a4",
      "name": "Create Ollama Embedding - HTTP Request"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "output_points = []\n\n# Loop through all the rows inside n8n's native input array\nfor item in _items:\n    # Your exact logic, wrapped safely inside the loop structure\n    chunk_id = item[\"json\"][\"chunk_id\"]\n    chunk_text = item[\"json\"][\"chunk_text\"]\n    \n    # Extracts the flat vector list from Ollama's nested response array\n    embedding_vector = item[\"json\"][\"embeddings\"][0]\n    \n    # Append the exact dictionary format Qdrant needs to our collection list\n    output_points.append({\n        \"json\": {\n            \"id\": chunk_id,\n            \"vector\": embedding_vector,\n            \"payload\": {\n                \"chunk_id\": chunk_id,\n                \"text\": chunk_text\n            }\n        }\n    })\n\n# Return the entire completed batch of points to the next node\nreturn output_points\n"
      },
