        "pythonCode": "output_items = []\n\nfor incoming_object in _items:\n    qdrant_results = incoming_object.get(\"json\", {}).get(\"result\", [])\n\n    retrieved_policies = []\n\n    for result in qdrant_results:\n        payload = result.get(\"payload\", {})\n\n        policy_id = payload.get(\"chunk_id\")\n        policy_text = payload.get(\"text\", \"\")\n        retrieval_score = result.get(\"score\")\n\n        retrieved_policies.append({\n            \"matched_policy_id\": policy_id,\n            \"retrieval_score\": retrieval_score,\n            \"retrieved_policy\": policy_text\n        })\n\n    output_items.append({\n        \"json\": {\n            \"retrieved_policies\": retrieved_policies\n        }\n    })\n\nreturn output_items"
