    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this customer feedback:\n\n{{ $json.body.feedback }}\n\nReturn ONLY valid JSON in this exact format:\n{\n  \"sentiment\": \"positive | neutral | negative | mixed\",\n  \"issue\": \"short description of the issue or none\"\n}\n\nRules:\n- sentiment must be exactly one of: positive, neutral, negative, mixed\n- neutral = factual / no emotion\n- negative = only negative feedback\n- positive = only positive feedback\n- mixed = both positive and negative feedback\n- if positive or neutral, issue must be \"none\"\n- do not explain\n- do not use markdown",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -2016,
