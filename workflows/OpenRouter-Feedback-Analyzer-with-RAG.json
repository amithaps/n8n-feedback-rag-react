    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer feedback: {{ $('Webhook').item.json.body.feedback }}\n\nSentiment: {{ $('If').item.json.output.sentiment }}\nIssue: {{ $('If').item.json.output.issue }}\nPolicy: {{ $json.retrieved_policy }}\n\nAs an experienced customer support representative write a short response to the customer.\n\nRules:\n- only one sentence.\n- no greeting\n- no signature\n- acknowledge the issue\n- sound empathetic and professional\n- do not mention anything unrelated to the issue\n- do not invent policy details\n- Use the retrieved policy as a guidance to construct the response. Do not mention \"policy\" or \"knowledge base\" to the customer.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -784,
        896
      ],
